{
  "name": "@dsh-eac/market",
  "version": "0.1.0-mvp.9",
  "description": "EAC community market plugin for official DeepSeek Harness Desktop",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./client/extensions": { "types": "./lib/types/client/extensions/contract.d.ts", "default": "./lib/types/client/extensions/contract.js" },
    "./client/typert": { "types": "./lib/typert.client.d.ts", "default": "./lib/typert.client.js" },
    "./types": { "types": "./lib/types/contracts/types.d.ts", "default": "./lib/types/contracts/types.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js", "lib/client.js",
    "lib/types/**/*.js", "lib/types/**/*.d.ts",
    "lib/typert.host.js", "lib/typert.host.d.ts",
    "lib/typert.client.js", "lib/typert.client.d.ts",
    "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts",
    "data/index.json", "cordis.patch.yml", "dsh-plugin.json", "README.md"
  ],
  "license": "MIT",
  "engines": { "node": ">=24", "dsh": "*" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": false
    }
  },
  "dependencies": { "zod": "^4.4.3" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-atomic-write": "workspace:*",
    "@deepseek-ai/dsh-plugin-manager": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": ">=18"
  },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.1.7-rc.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "0.1.7-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}

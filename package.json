{
  "name": "eac-market-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/market-core",
    "packages/market"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "test:pack": "node scripts/verify-package.mjs",
    "test:catalog": "vitest run tests/catalog tests/delivery tests/authoring",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm test:pack",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.1.7-rc.2",
    "@types/node": "^24.10.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.10",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
